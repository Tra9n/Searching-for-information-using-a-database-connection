# Nominatim требует реальный email в User-Agent
NOMINATIM_USER_AGENT=SkyProject/1.0 (your_email@example.com)

# Опционально: OpenSky OAuth2 (для более высоких лимитов)
# OPENSKY_USER= ...
# OPENSKY_PASSWORD= ...

# Параметры подключения к PostgreSQL (используются в тестах)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
TEST_DB_NAME=sky_db_test